{
  "apf-preset": 1,
  "plugin": "dev.miha.apf.demo-synth",
  "name": "Sine Lead",
  "type": "Lead",
  "subtype": "Soft",
  "mood": ["Soft", "Clean"],
  "description": "Pure sine lead; the mod wheel adds vibrato",
