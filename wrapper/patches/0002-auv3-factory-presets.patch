+// --- Factory presets (clap.preset-discovery + clap.preset-load) ---
+
+- (NSArray<AUAudioUnitPreset *> *)factoryPresets
+{
+  if (!_presetIndex) return @[];
+  @synchronized(self)
+  {
+    if (_factoryPresetsCache) return _factoryPresetsCache;
+  }
+  // A host asks early; a short wait beats an empty menu. A slower crawl is announced
+  // through KVO on factoryPresets when it completes.
+  if (!_presetIndex->waitUntilComplete(1000)) return @[];
+  const auto presets = _presetIndex->presets();
+  NSMutableArray<AUAudioUnitPreset *> *list = [NSMutableArray arrayWithCapacity:presets.size()];
+  for (size_t i = 0; i < presets.size(); ++i)
+  {
+    AUAudioUnitPreset *p = [AUAudioUnitPreset new];
+    p.number = (NSInteger)i;
+    NSString *name = [NSString stringWithUTF8String:presets[i].displayName().c_str()];
+    p.name = name ? name : @"Preset";
+    [list addObject:p];
+  }
+  @synchronized(self)
+  {
+    _factoryPresetsCache = list;
+  }
+  return list;
+}
+
+- (AUAudioUnitPreset *)currentPreset
+{
+  @synchronized(self)
+  {
+    return _currentPresetValue;
+  }
+}
+
+- (void)setCurrentPreset:(AUAudioUnitPreset *)preset
+{
+  if (preset && preset.number >= 0 && _presetIndex && _impl && _impl->_plugin)
+  {
+    Clap::PresetEntry entry;
+    if (!_presetIndex->presetAt((size_t)preset.number, entry))
+    {
+      AUV3ERR("setCurrentPreset: no preset %ld", (long)preset.number);
+      return;
+    }
+    bool loaded;
+    {
+      auto mainGuard = _impl->_plugin->AlwaysMainThread();
+      loaded = _impl->_plugin->loadPresetFromLocation(entry.locationKind,
+                                                      entry.location.empty() ? nullptr : entry.location.c_str(),
+                                                      entry.loadKey.empty() ? nullptr : entry.loadKey.c_str());
+    }
+    if (!loaded)
+    {
+      AUV3ERR("setCurrentPreset: the plugin refused preset %ld", (long)preset.number);
+      return;
+    }
+  }
+  @synchronized(self)
+  {
+    _currentPresetValue = preset;
+  }
+}
+
+- (void)_presetLoadedKind:(uint32_t)kind location:(const std::string &)location key:(const std::string &)key
+{
+  if (!_presetIndex) return;
+  size_t index = 0;
+  if (!_presetIndex->indexOf(kind, location.c_str(), key.c_str(), index)) return;
+  NSArray<AUAudioUnitPreset *> *presets = [self factoryPresets];
+  if (index >= presets.count) return;
+  [self willChangeValueForKey:@"currentPreset"];
+  @synchronized(self)
+  {
+    _currentPresetValue = presets[index];
+  }
+  [self didChangeValueForKey:@"currentPreset"];
+}
