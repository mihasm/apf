+// The smallest and largest size the plugin's GUI takes, through adjust_size. Equal to
+// the current size for a GUI that cannot resize.
+- (void)guiLimitsMin:(CGSize *)outMin max:(CGSize *)outMax
+{
+  uint32_t w = _impl ? _impl->_guiWidth : 0, h = _impl ? _impl->_guiHeight : 0;
+  CGSize cur = CGSizeMake(w, h), lo = cur, hi = cur;
+  if ([self canResizeGUI])
+  {
+    auto mainGuard = _impl->_plugin->AlwaysMainThread();
+    auto *gui = _impl->_plugin->_ext._gui;
+    uint32_t minW = 1, minH = 1, maxW = 16384, maxH = 16384;
+    if (gui->adjust_size)
+    {
+      gui->adjust_size(_impl->_plugin->_plugin, &minW, &minH);
+      gui->adjust_size(_impl->_plugin->_plugin, &maxW, &maxH);
+    }
+    lo = CGSizeMake(minW, minH);
+    hi = CGSizeMake(maxW, maxH);
+  }
+  if (outMin) *outMin = lo;
+  if (outMax) *outMax = hi;
+}
+
+// Hosts ask which of their view configurations (sizes, 0 = any) the audio unit can
+// take. A resizable GUI takes any size within its limits; a fixed one only its own.
+- (NSIndexSet *)supportedViewConfigurations:(NSArray<AUAudioUnitViewConfiguration *> *)configurations
+{
+  CGSize lo, hi;
+  [self guiLimitsMin:&lo max:&hi];
+  NSMutableIndexSet *result = [NSMutableIndexSet indexSet];
+  [configurations enumerateObjectsUsingBlock:^(AUAudioUnitViewConfiguration *c, NSUInteger i, BOOL *) {
+    BOOL w = c.width == 0 || (c.width >= lo.width && c.width <= hi.width);
+    BOOL h = c.height == 0 || (c.height >= lo.height && c.height <= hi.height);
+    if (w && h && (!(lo.width < hi.width || lo.height < hi.height) || (c.width == 0 && c.height == 0))) [result addIndex:i];
+  }];
+  AUV3LOG("supportedViewConfigurations: %lu offered, %lu supported", (unsigned long)configurations.count,
+          (unsigned long)result.count);
+  return result;
+}
+
+- (void)selectViewConfiguration:(AUAudioUnitViewConfiguration *)configuration
+{
+  AUV3LOG("selectViewConfiguration: %.0fx%.0f", configuration.width, configuration.height);
+  if (configuration.width > 0 && configuration.height > 0 && [self canResizeGUI])
+    [self _applyGUISizeWidth:(uint32_t)configuration.width height:(uint32_t)configuration.height];
+}
