   union
@@ -750,6 +751,19 @@ class AUv3ImplDetail : public Clap::IHost, public Clap::IAutomation, public os::
     _queueToUI.push(evt);
   }
 
+  // Automation the host scheduled into the render: the value cache must follow it, or the
+  // tree keeps reporting the value last set through it (a knob moved by hand) while the
+  // plugin plays the automation, and the host's controls show that stale value.
+  void onHostValue(clap_id id, double value) override
+  {
+    queueEvent evt;
+    evt._type = queueEvent::type::hostvalue;
+    evt._data._value = {};
+    evt._data._value.param_id = id;
+    evt._data._value.value = value;
+    _queueToUI.push(evt);
+  }
+
   // Drain the audio→UI parameter queue and forward automation events to the host.
   // Safe to call while processing — only touches AUParameter objects, no CLAP calls.
   void drainParameterQueue()
@@ -814,6 +828,25 @@ class AUv3ImplDetail : public Clap::IHost, public Clap::IAutomation, public os::
           }
           break;
         }
+        case queueEvent::type::hostvalue:
+        {
+          // The cache the tree's value provider reads, and the tree's own value: a host out
+          // of process mirrors the tree and only refreshes on a set. No touch or release
+          // around it — the host sent this value, it is not an edit to record — and the echo
+          // to the plugin is suppressed above.
+          bool changed;
+          {
+            std::lock_guard<std::mutex> lock(_paramCacheMutex);
+            auto &cached = _paramValueCache[evt._data._value.param_id];
+            changed = cached != evt._data._value.value;
+            cached = evt._data._value.value;
+          }
+          AUParameter *param =
+              [_parameterTree parameterWithAddress:(AUParameterAddress)evt._data._value.param_id];
+          if (param && changed)
+            [param setValue:(AUValue)evt._data._value.value originator:_parameterObserverToken];
+          break;
+        }
       }
 
       s_suppressParamObserverEcho = false;
